# Copy to .env and set your values. Used by docker-compose for DB and connection strings.
# Do not commit .env (it is in .gitignore).
#
# Dev environment – where to put .env:
#   • Web (Next.js):  web/.env.local   → NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WEBSITE_DOMAIN (e.g. http://localhost:8000, http://localhost:3000)
#   • Engine (API):   engine/.env      → CORS_ORIGINS (if needed), DATABASE_URL, SUPERTOKENS_*, etc. (engine also reads project root .env)

POSTGRES_USER=doadmin
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=movieshaker

# Optional: SuperTokens with Managed Postgres (e.g. DigitalOcean). If set, SuperTokens uses this instead of db:5432/supertokens.
# SUPERTOKENS_DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/supertokens?sslmode=require

# Frontend (Next.js in web/). Copy to web/.env.local for local dev. For production (e.g. DO App Platform), set in dashboard.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_AUTH_API_URL=https://auth.rapidmvp.io
# NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000
# NEXT_PUBLIC_AUTH_BASE_URL=https://auth.rapidmvp.io

# Engine CORS: add extra frontend origin(s) if needed (comma-separated).
# In production, localhost origins are excluded unless explicitly listed here.
# Safe defaults already include https://movieshaker.com and https://www.movieshaker.com.
# CORS_ORIGINS=https://dolphin-app-9dvbj.ondigitalocean.app
# APP_ENV=production
# SQL_ECHO=false

# Email: engine calls Next.js internal send-email API. Same key in both engine and web.
# Resend is required for auth email delivery in shared-auth deployments.
# RESEND_API_KEY=re_xxx
# RESEND_FROM=MovieShaker Auth <noreply@auth.rapidmvp.io>
# INTERNAL_API_KEY=your-secret-key
# WEB_INTERNAL_URL=http://web:3000
# API_BASE_URL and WEBSITE_DOMAIN: used for verification link and redirect (e.g. https://api.movieshaker.com, https://movieshaker.com)
# API_BASE_URL=https://api.movieshaker.com
# WEBSITE_DOMAIN=https://movieshaker.com

# Shared auth SSO (for multi-app rollouts)
# AUTH_BASE_URL=https://auth.rapidmvp.io
# AUTH_CALLBACK_URL=https://movieshaker.com/auth/callback
# ALLOWED_RETURN_TO_URLS=https://movieshaker.com/auth/callback,https://rapidmvp.io/auth/callback,https://afilminabox.com/auth/callback,https://reelinvesting.com/auth/callback,https://ooocreatives.com/auth/callback

# Gateway (source of truth for model routing/generation)
# GATEWAY_BASE_URL=https://models.rapidmvp.io
# GATEWAY_INTERNAL_API_KEY=your-gateway-internal-key
# GATEWAY_TIMEOUT_SECONDS=45
# GATEWAY_VERIFY_TLS=true

# Media handler (FFmpeg service)
# MEDIA_HANDLER_BASE_URL=https://media-handler.example.com
# MEDIA_HANDLER_INTERNAL_API_KEY=your-media-handler-internal-key
# MEDIA_HANDLER_TIMEOUT_SECONDS=60
# MEDIA_HANDLER_VERIFY_TLS=true
# FILM_IN_A_BOX_MODEL=google/gemma-3-12b-it:free
