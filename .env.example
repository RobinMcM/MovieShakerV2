# Copy to .env and set your values. Used by docker-compose for DB and connection strings.
# Do not commit .env (it is in .gitignore).

POSTGRES_USER=doadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=movieshaker

# Optional: SuperTokens with Managed Postgres (e.g. DigitalOcean). If set, SuperTokens uses this instead of db:5432/supertokens.
# SUPERTOKENS_DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/supertokens?sslmode=require

# Frontend (Next.js in web/). Copy to web/.env.local for local dev. For production (e.g. DO App Platform), set in dashboard.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000

# Engine CORS: allow production frontend origin(s). Set on Droplet so API accepts requests from your frontend (comma-separated if multiple).
# CORS_ORIGINS=https://dolphin-app-9dvbj.ondigitalocean.app
