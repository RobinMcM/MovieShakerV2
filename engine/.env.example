# Engine (FastAPI) – copy to .env in this directory for local dev.
# CORS: comma-separated origins allowed to call this API (e.g. your Next.js dev URL).
# If unset, defaults include http://localhost:3000 and http://localhost:3001.
# CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# APP_ENV=development
# API_BASE_URL and WEBSITE_DOMAIN are used by SuperTokens for auth/session routes.
# API_BASE_URL=http://localhost:8000
# WEBSITE_DOMAIN=http://localhost:3000
# AUTH_DOMAIN=https://auth.rapidmvp.io
# AUTH_BASE_URL=https://auth.rapidmvp.io
# APP_BASE_URL=https://movieshaker.com
# AUTH_CALLBACK_URL=https://movieshaker.com/auth/callback
# ALLOWED_RETURN_TO_URLS=https://movieshaker.com/auth/callback,https://rapidmvp.io/auth/callback,https://afilminabox.com/auth/callback,https://reelinvesting.com/auth/callback,https://ooocreatives.com/auth/callback
# SQL_ECHO=false  # Set true only when debugging SQL locally

# Gateway (source of truth for AI model routing/generation)
# GATEWAY_BASE_URL=https://134.209.184.66
# GATEWAY_INTERNAL_API_KEY=your-gateway-internal-key
# GATEWAY_TIMEOUT_SECONDS=45
# GATEWAY_VERIFY_TLS=false

# Media handler (FFmpeg service)
# MEDIA_HANDLER_BASE_URL=https://media-handler.example.com
# MEDIA_HANDLER_INTERNAL_API_KEY=your-media-handler-internal-key
# MEDIA_HANDLER_TIMEOUT_SECONDS=60
# MEDIA_HANDLER_VERIFY_TLS=false
# FILM_IN_A_BOX_MODEL=google/gemma-3-12b-it:free

# Database (defaults used if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/movieshaker

# SuperTokens (default for local: http://supertokens:3567)
# SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# Auth email delivery (Resend)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=RapidMVP Auth <auth@rapidmvp.io>

# Optional: storage, email, etc. See other engine modules for env var names.
