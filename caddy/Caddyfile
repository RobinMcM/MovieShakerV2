# api.movieshaker.com -> engine:8000 (CRUD)
# api.movieshaker.com/auth/* -> https://auth.rapidmvp.io/auth/* (central auth)
# HTTPS certificate obtained and renewed automatically by Caddy (Let's Encrypt).

api.movieshaker.com {
    @auth path /auth /auth/*
    handle @auth {
        @preflight method OPTIONS
        handle @preflight {
            header Access-Control-Allow-Origin "https://movieshaker.com"
            header Access-Control-Allow-Credentials "true"
            header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
            header Access-Control-Allow-Headers "Content-Type, rid, anti-csrf, fdi-version, st-auth-mode, Authorization"
            respond "" 204
        }
        reverse_proxy https://auth.rapidmvp.io
    }

    handle {
        reverse_proxy engine:8000
    }
}

# auth.rapidmvp.io -> engine:8000 (auth endpoints)
# HTTPS certificate obtained and renewed automatically by Caddy (Let's Encrypt).
auth.rapidmvp.io {
    # SuperTokens Core endpoint for apps that use SUPERTOKENS_CONNECTION_URI.
    # This must answer /core/apiversion with HTTP 200.
    handle_path /core/* {
        reverse_proxy supertokens:3567
    }

    @auth path /auth /auth/*
    handle @auth {
        reverse_proxy engine:8000
    }

    @health path /health
    handle @health {
        reverse_proxy engine:8000
    }

    respond 404
}
