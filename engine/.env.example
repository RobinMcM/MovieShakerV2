# Engine (FastAPI) – copy to .env in this directory for local dev.
# CORS: comma-separated origins allowed to call this API (e.g. your Next.js dev URL).
# If unset, defaults include http://localhost:3000 and http://localhost:3001.
# CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# API_BASE_URL and WEBSITE_DOMAIN are used by SuperTokens for auth/session routes.
# API_BASE_URL=http://localhost:8000
# WEBSITE_DOMAIN=http://localhost:3000

# Database (defaults used if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/movieshaker

# SuperTokens (default for local: http://supertokens:3567)
# SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# Optional: storage, email, etc. See other engine modules for env var names.
