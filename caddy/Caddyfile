# api.movieshaker.com -> engine:8000 (CRUD)
# api.movieshaker.com/auth/* -> https://auth.rapidmvp.io/auth/* (central auth)
# HTTPS certificate obtained and renewed automatically by Caddy (Let's Encrypt).

api.movieshaker.com {
    @auth path /auth /auth/*
    handle @auth {
        reverse_proxy https://auth.rapidmvp.io
    }

    handle {
        reverse_proxy engine:8000
    }
}
